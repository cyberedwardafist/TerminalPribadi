# ==== Salin ke .env (lokal) atau isi di Vercel > Project > Settings > Environment Variables. Setelah diubah di Vercel: Redeploy ====

# Supabase > Project Settings > API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# RAHASIA: hanya di server, jangan pernah di frontend. Pakai key "secret" (sb_secret_...) atau "service_role" (eyJ...), BUKAN anon/publishable
SUPABASE_SERVICE_ROLE_KEY=

# Hanya untuk "npm run migrate" (membuat tabel otomatis). TIDAK dipakai server, tidak perlu diisi di Vercel.
# Supabase > tombol "Connect" > Connection string > "Session pooler" (port 5432). Ganti [PASSWORD] dengan password database; karakter khusus di-URL-encode (@ -> %40)
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Rahasia aplikasi, min. 32 karakter. Buat dengan:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Email OTP (wajib untuk produksi), satu baris. USER dan PASSWORD di-URL-encode (@ -> %40).
#   Gmail (465 TLS) : smtps://akun%40gmail.com:APP_PASSWORD@smtp.gmail.com:465   (APP_PASSWORD = 16 huruf dari myaccount.google.com/apppasswords, wajib Verifikasi 2 Langkah)
#   Port 587        : smtp://USER:PASSWORD@HOST:587   (STARTTLS otomatis)
#   Contoh lain     : smtps://USER:PASSWORD@smtp.resend.com:465   atau   smtps://USER:PASSWORD@smtp-relay.brevo.com:465
# Port 25 diblokir di Vercel.
SMTP_URL=
# Opsional. Kosong = memakai USER dari SMTP_URL. Banyak server SMTP menolak pengirim yang bukan miliknya
# MAIL_FROM=Terminal Chart <alamat@domainmu.id>

# --- Opsional: tanpa ini endpoint cron/admin otomatis tertutup. Isi acak min. 16 karakter ---
# Cron Vercel (harian) mengirimnya sebagai header Authorization: Bearer
# CRON_SECRET=
# Untuk /api/admin/* (isi data awal, tes email)
# ADMIN_TOKEN=

# --- Opsional ---
# ALLOWED_ORIGINS=https://nama-proyekmu.vercel.app   # default * (semua). Perlu hanya bila frontend di domain lain
# PUBLIC_MARKET=1                                    # data pasar tanpa login + cache CDN
# TOKEN_DAYS=14                                      # umur sesi login
# IDX_HOLIDAYS=2026-12-25,2026-12-31                 # libur bursa (YYYY-MM-DD, WIB)

# --- Hanya uji lokal (JANGAN diaktifkan di produksi) ---
# MAIL_PROVIDER=log      kode OTP dicetak di terminal/log, email tidak dikirim
# RATE_LIMIT=off         matikan pembatas laju
