# =====================================================================================================
#  TERMINAL CHART - format .env LENGKAP
#  Lokal   : salin file ini menjadi ".env" (tepat di folder yang sama dengan package.json), isi, lalu "npm run dev".
#  Vercel  : isi nama dan nilai yang sama di Project > Settings > Environment Variables, lalu REDEPLOY.
#  Aturan  : satu baris satu variabel, TANPA spasi di sekitar "=", tanpa kutip (kutip boleh, tapi tidak perlu).
#            Baris berawalan # adalah komentar. Jangan pernah commit .env atau memasukkannya ke frontend.
# =====================================================================================================


# ---------- 1. WAJIB: database (Supabase) ----------------------------------------------------------
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# RAHASIA. Pakai "secret" (sb_secret_...) atau "service_role" (eyJ...), BUKAN anon / publishable.
SUPABASE_SERVICE_ROLE_KEY=

# Hanya untuk "npm run migrate" (membuat tabel otomatis). Tidak dipakai server, tidak perlu diisi di Vercel.
# Supabase > tombol Connect > Session pooler (port 5432). Ganti [PASSWORD]; karakter khusus di-URL-encode (@ -> %40)
# DATABASE_URL=postgresql://postgres.xxxxxxxx:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres
# DB_SSL=true


# ---------- 2. WAJIB: kunci login ------------------------------------------------------------------
# Acak, minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Jika diganti, semua pengguna otomatis keluar dan OTP yang sedang berjalan tidak berlaku.
JWT_SECRET=
# Umur sesi login (hari). Bawaan 14
TOKEN_DAYS=14


# ---------- 3. WAJIB agar OTP terkirim: email lewat SMTP --------------------------------------------
# Cara paling mudah: isi 5 baris di bawah. Contoh ini untuk GMAIL.
#
#   Gmail : 1) Aktifkan Verifikasi 2 Langkah di akun Google
#           2) Buat App Password di https://myaccount.google.com/apppasswords  (hasilnya 16 huruf, boleh dengan spasi)
#           3) SMTP_USER = alamat Gmail lengkap, SMTP_PASS = App Password tadi (BUKAN password Gmail biasa)
#           Batas kirim Gmail kira-kira 500 email per hari.
#
#   Hosting/domain sendiri (cPanel, Hostinger, Niagahoster, dll): pakai host dari panel email, mis. mail.domainmu.id,
#   port 465 atau 587, user = alamat email lengkap, pass = password email itu.
#   Layanan lain : Brevo smtp-relay.brevo.com:587 | Resend smtp.resend.com:465 (user "resend", pass = API key) | Mailgun smtp.mailgun.org:587
#
SMTP_HOST=smtp.gmail.com
# 465 = TLS langsung (disarankan). 587 = STARTTLS. Port 25 diblokir di Vercel.
SMTP_PORT=465
# Biasanya TIDAK perlu diisi: otomatis port 465 = TLS langsung, port lain (587) = STARTTLS.
# Isi hanya bila server memakai port tak umum: true = TLS langsung, false = STARTTLS
# SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Nama + alamat pengirim yang tampil di email. OPSIONAL: kosongkan/hapus bila tidak yakin (otomatis memakai SMTP_USER).
# Server SMTP menolak pengirim yang bukan miliknya; Gmail selalu memakai akun login sebagai pengirim.
# MAIL_FROM=Terminal Chart <alamat-smtp-kamu@gmail.com>

# Alternatif satu baris (JANGAN diisi bersamaan dengan SMTP_HOST di atas; kalau diisi, SMTP_URL yang dipakai).
# USER dan PASSWORD harus di-URL-encode (@ -> %40, spasi -> %20, # -> %23).
#   Gmail 465 : smtps://akun%40gmail.com:APP_PASSWORD@smtp.gmail.com:465
#   Port 587  : smtp://USER:PASSWORD@HOST:587
# SMTP_URL=

# Cara lain selain SMTP (hanya dipakai bila SMTP_HOST dan SMTP_URL kosong):
# RESEND_API_KEY=
# BREVO_API_KEY=
# MAIL_PROVIDER=smtp   # kunci pilihan manual: smtp | gmail | resend | brevo

# Cek email setelah diisi (tanpa harus mendaftar):
#   npm run mail:test                         -> tes koneksi + login SMTP
#   npm run mail:test -- emailkamu@gmail.com  -> sekaligus kirim 1 email contoh


# ---------- 4. OPSIONAL: cron dan admin -------------------------------------------------------------
# Acak, minimal 16 karakter. Tanpa ini endpoint terkait otomatis tertutup.
# Vercel Cron (harian) mengirimnya sebagai header "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=
# Untuk /api/admin/* (tes email, isi data awal). Kirim sebagai header "x-admin-token"
ADMIN_TOKEN=


# ---------- 5. OPSIONAL: perilaku aplikasi ----------------------------------------------------------
# Hanya perlu bila frontend ada di domain LAIN dari backend. Pisahkan dengan koma. Kosong = semua (*)
# ALLOWED_ORIGINS=https://nama-proyekmu.vercel.app
# 1 = data pasar bisa dibuka tanpa login dan di-cache CDN (hemat, tapi siapa pun bisa memakainya)
# PUBLIC_MARKET=1
# Libur bursa IDX tambahan (YYYY-MM-DD, WIB), pisahkan dengan koma
# IDX_HOLIDAYS=2026-12-25,2026-12-31
# Sumber berita tambahan: kategori|Nama|url;kategori|Nama|url   (kategori: idx, us, cry, com, fx)
# NEWS_FEEDS_EXTRA=idx|Contoh Berita|https://contoh.id/rss
# Sumber data tambahan (semua OPSIONAL; tanpa kunci, aplikasi memakai sumber bawaan)
# Finnhub: berita pasar global/forex/kripto. Daftar gratis di https://finnhub.io (60 panggilan/menit). Kunci dikirim lewat header.
# FINNHUB_API_KEY=
# Alpha Vantage: berita + label sentimen. Paket gratis hanya 25 panggilan/hari, jadi dipanggil paling sering 1x per 6 jam.
# ALPHAVANTAGE_API_KEY=
# CoinGecko: kapitalisasi pasar kripto untuk peta pasar berjalan TANPA kunci. Isi kunci "Demo" bila sering kena batas (429).
# COINGECKO_API_KEY=
# Port server lokal ("npm run dev"). Bawaan 3000
# PORT=3000


# ---------- 6. HANYA UJI LOKAL - JANGAN DIAKTIFKAN DI PRODUKSI ---------------------------------------
# MAIL_PROVIDER=log   -> kode OTP dicetak di terminal, email TIDAK dikirim (kalau OTP "tidak sampai", cek baris ini dulu)
# RATE_LIMIT=off      -> matikan pembatas laju
