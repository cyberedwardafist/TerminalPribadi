# ===== WAJIB =====
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=            # Supabase > Project Settings > API Keys. Boleh "secret" (sb_secret_...) atau service_role (eyJ...). BUKAN anon/publishable. JANGAN dipakai di frontend
JWT_SECRET=                           # acak, min 32 karakter:  openssl rand -base64 48
CRON_SECRET=                          # acak, min 16 karakter. Vercel Cron otomatis mengirimnya sebagai Bearer
ADMIN_TOKEN=                          # acak, min 16 karakter, untuk /api/admin/*

# ===== EMAIL OTP LEWAT SMTP (utama) =====
SMTP_HOST=smtp.gmail.com              # Gmail: smtp.gmail.com | Brevo: smtp-relay.brevo.com | Zoho: smtp.zoho.com | hosting/cPanel: mail.domainanda.com
SMTP_PORT=465                         # 465 = TLS langsung (otomatis). 587 = STARTTLS (otomatis). Port 25 diblokir di Vercel
SMTP_USER=                            # alamat/login SMTP. Gmail: alamat Gmail lengkap
SMTP_PASS=                            # Gmail: App Password 16 huruf (BUKAN password login; myaccount.google.com/apppasswords, wajib Verifikasi 2 Langkah). Spasi di App Password boleh dibiarkan
# SMTP_FROM=Terminal Chart <alamat@domainanda.com>   # opsional. Kosong = memakai SMTP_USER. Banyak server SMTP menolak pengirim yang bukan miliknya
# SMTP_SECURE=true                    # opsional: paksa TLS langsung (true) atau STARTTLS (false). Kosong = ikut port

# ----- cadangan, hanya dipakai bila SMTP_HOST kosong (urutan: Gmail > Resend > Brevo API) -----
# GMAIL_USER=akunanda@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
# RESEND_API_KEY=                     # resend.com. Kirim ke email siapa pun butuh domain terverifikasi
# BREVO_API_KEY=                      # brevo.com (sender harus diverifikasi)
# MAIL_FROM=Terminal Chart <noreply@domainanda.com>  # untuk Resend/Brevo
# MAIL_PROVIDER=smtp                  # opsional: smtp | gmail | resend | brevo | log. Kosong = otomatis
# MAIL_PROVIDER=log                   # uji coba: kode OTP dicetak ke log Vercel (jangan untuk produksi)

# ===== OPSIONAL =====
# ALLOWED_ORIGINS=https://app.domainanda.com   # default *. Perlu hanya bila frontend di domain lain
# PUBLIC_MARKET=1                     # data pasar tanpa login + cache CDN (hemat invocation, tapi terbuka untuk umum)
# TOKEN_DAYS=14                       # umur sesi login
# IDX_HOLIDAYS=2026-12-25,2026-12-31  # libur bursa (YYYY-MM-DD, WIB) untuk status pasar
# NEWS_FEEDS_EXTRA=idx|Nama Sumber|https://contoh.com/rss;fx|Sumber FX|https://contoh.com/fx.xml
# RATE_LIMIT=off                      # hanya untuk pengujian
