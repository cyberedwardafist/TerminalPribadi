{
  "name": "terminalpribadi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend Terminal Chart: Vercel Functions (Node) + Supabase Postgres. Tanpa dependensi runtime (pg hanya untuk \"npm run migrate\", tidak dipakai server).",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "migrate": "node scripts/migrate.js",
    "dev": "node scripts/dev.js",
    "dev:fake": "node scripts/dev.js --fake",
    "dev:vercel": "vercel dev",
    "check": "npm test",
    "preflight": "node scripts/preflight.js",
    "migrate:sql": "node scripts/setup-sql.js",
    "mail:test": "node scripts/mail-test.js",
    "rt:test": "node scripts/rt-test.js"
  },
  "devDependencies": {
    "pg": "^8.13.0"
  }
}
